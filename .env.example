# ==============================================================================
# EdgeFleet Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# A strong random secret for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local gateway (default)
DATABASE_URL=sqlite:///./edgefleet.db
# PostgreSQL for cloud: postgresql+asyncpg://user:pass@host:5432/edgefleet

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=edgefleet
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_CLIENT_ID=edgefleet-backend

# ── Authentication ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@edgefleet.local

# ── Firmware Storage ────────────────────────────────────────────────────────
FIRMWARE_STORAGE_PATH=./firmware_storage
MAX_UPLOAD_SIZE_MB=16

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Telemetry ────────────────────────────────────────────────────────────────
TELEMETRY_RETENTION_DAYS=30
HEARTBEAT_TIMEOUT_SECONDS=90

# ── Deployment ───────────────────────────────────────────────────────────────
DEPLOYMENT_CONCURRENCY_LIMIT=1
DEPLOYMENT_TIMEOUT_SECONDS=300

# ── Arduino ──────────────────────────────────────────────────────────────────
AVRDUDE_PATH=/usr/bin/avrdude
ARDUINO_SERIAL_PORT_PATTERNS=/dev/ttyACM*,/dev/ttyUSB*

# ── Cloud Sync ───────────────────────────────────────────────────────────────
CLOUD_ENABLED=false
CLOUD_API_URL=https://cloud.edgefleet.example.com/api/v1
CLOUD_API_KEY=CHANGE_ME_CLOUD_API_KEY
CLOUD_SYNC_INTERVAL_SECONDS=60
CLOUD_SYNC_MAX_RETRIES=10
CLOUD_SYNC_QUEUE_MAX_SIZE=10000
CLOUD_SYNC_RETENTION_DAYS=7

# ── Mock Mode ────────────────────────────────────────────────────────────────
MOCK_MODE=false
