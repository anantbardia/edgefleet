# EdgeFleet Cloud Environment Configuration
APP_NAME=EdgeFleet Cloud Control Plane
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=GENERATE_A_VERY_LONG_SECRET_KEY_FOR_JWT

POSTGRES_PASSWORD=generate_a_secure_db_password
DATABASE_URL=postgresql+asyncpg://edgefleet:generate_a_secure_db_password@db:5432/edgefleet_cloud

CORS_ORIGINS=https://fleet.yourdomain.com
FIRMWARE_STORAGE_PATH=/app/firmware_storage
MAX_UPLOAD_SIZE_MB=64

CLOUD_ENABLED=true
